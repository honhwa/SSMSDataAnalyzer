<UserControl x:Class="SsmsDataAnalyzer.Vsix.History.QueryHistoryView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}">

    <!--
        docs/query-history-plan.md §4 Phase 1 item 3: virtualized list (When/Server/Database/
        Duration-Outcome/Query first line), a read-only preview pane below a splitter, a search
        box with a 250ms debounce (QueryHistoryViewModel), and a date-range dropdown. Actions
        (item 7) are a bottom toolbar plus a context menu; double-click = Open, matching the
        plan's own picture in §1.

        VS theme brushes only (project rule) — SolidColorBrush wrapping a DynamicResource
        EnvironmentColors key, same convention as PivotView/GridFindView. No
        AlternatingRowBackground on the DataGrid (project rule: it silently beats a style
        trigger — the error-row highlight below would vanish on every other row).
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="QhErrorRowBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemHighlightColorKey}}" Opacity="0.18" />
        <SolidColorBrush x:Key="QhGrayTextBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemGrayTextColorKey}}" />
        <SolidColorBrush x:Key="QhGridLineBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemGrayTextColorKey}}" Opacity="0.30" />

        <Style x:Key="QhToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search box (prefixes: sql:/server:/database:/starred:/error: — HistoryFilter.Parse)
             plus the date-range dropdown, item 4/5. -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="sql: server: database: (or db:) doc: starred:true error:true closed:true — bare words match the query text; &quot;quoted phrases&quot; match as one term." />
            <!-- docs/query-history-plan.md §4 Phase 2 item 9: off by default. -->
            <CheckBox Grid.Column="1" Content="Group identical" VerticalAlignment="Center" Margin="0,0,12,0"
                      IsChecked="{Binding GroupIdenticalText}"
                      ToolTip="Collapse executions with identical query text; each row shows the newest run and how many it stands for." />
            <ComboBox Grid.Column="2" Width="140" VerticalAlignment="Center"
                      ItemsSource="{Binding DateRangeOptions}" SelectedItem="{Binding SelectedDateRange}" />
        </Grid>

        <!--
            The list. Virtualized (EnableRowVirtualization + Recycling), read-only, single-cell
            selection isn't required here (whole-row selection makes more sense for a history
            list than Pivot's cell-based copy). Double-click = Open in new query window (item 6).
        -->
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionUnit="FullRow" SelectionMode="Extended"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource QhGridLineBrush}"
                  MouseDoubleClick="HistoryGrid_MouseDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource QhErrorRowBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in new query window" Click="OpenMenuItem_Click" />
                    <MenuItem Header="Insert at cursor" Click="InsertMenuItem_Click" />
                    <MenuItem Header="Copy" Click="CopyMenuItem_Click" />
                    <MenuItem Header="Copy with header" Click="CopyWithHeaderMenuItem_Click" />
                    <MenuItem Header="Export selected..." Click="ExportSelectedMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Star/unstar" Click="StarMenuItem_Click" />
                    <MenuItem Header="Delete" Click="DeleteMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Find entries for this database" Click="FindForDatabaseMenuItem_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="★" Width="26" CanUserResize="False" SortMemberPath="Starred">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StarGlyph, Mode=OneWay}" HorizontalAlignment="Center"
                                       MouseLeftButtonUp="StarGlyph_MouseLeftButtonUp" Cursor="Hand" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="When" Binding="{Binding WhenText, Mode=OneWay}" Width="150" />
                <DataGridTextColumn Header="Server" Binding="{Binding Server, Mode=OneWay}" Width="140" />
                <DataGridTextColumn Header="Database" Binding="{Binding Database, Mode=OneWay}" Width="120" />
                <!-- docs/query-history-plan.md §4 Phase 2 item 11: find what you ran in a tab
                     you have since closed — doc:/closed: search on this column. -->
                <DataGridTextColumn Header="Document" Binding="{Binding DocumentName, Mode=OneWay}" Width="120" />
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationOutcomeText, Mode=OneWay}" Width="110" />
                <!-- docs/query-history-plan.md §4 Phase 2 item 9: how many runs this row
                     stands for once "Group identical" is on; empty otherwise. -->
                <DataGridTextColumn Header="Runs" Binding="{Binding GroupCountText, Mode=OneWay}" Width="45" />
                <DataGridTextColumn Header="Query" Binding="{Binding FirstLine, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- No explicit Background: an unverified EnvironmentColors key broke this build once
             (project rule) — the default GridSplitter chrome is fine here. -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Margin="0,4,0,4" />

        <!-- Read-only preview of the selected entry's full text (item 3). -->
        <TextBox Grid.Row="3" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />

        <!-- Bottom toolbar (item 7) + status text. -->
        <DockPanel Grid.Row="4" Margin="0,6,0,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource QhGrayTextBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QhToolbarButton}" Content="Open in new query window"
                        IsEnabled="{Binding HasSelection}" Click="OpenButton_Click" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Insert at cursor"
                        IsEnabled="{Binding HasSelection}" Click="InsertButton_Click" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Copy"
                        IsEnabled="{Binding HasSelection}" Click="CopyButton_Click" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Star/unstar"
                        IsEnabled="{Binding HasSelection}" Click="StarButton_Click" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Delete"
                        IsEnabled="{Binding HasSelection}" Click="DeleteButton_Click" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Export..." Click="ExportButton_Click"
                        ToolTip="Save the list as it is currently filtered to a .sql file (not encrypted)" />
                <Button Style="{StaticResource QhToolbarButton}" Content="Clear all history..." Click="ClearAllButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
