<UserControl x:Class="SsmsDataAnalyzer.Vsix.ScriptObject.ScriptObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}">

    <UserControl.Resources>
        <!-- Only EXISTING EnvironmentColors keys, same convention as AggregateSelectionView. -->
        <SolidColorBrush x:Key="ContextTextBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemGrayTextColorKey}}" />
        <SolidColorBrush x:Key="ScriptBackgroundBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemWindowColorKey}}" />
        <SolidColorBrush x:Key="ScriptTextBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemWindowTextColorKey}}" />
        <SolidColorBrush x:Key="ScriptSelectionBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemHighlightColorKey}}" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
            <Button x:Name="CopyButton" DockPanel.Dock="Left" Content="Copy" Padding="10,2" Margin="0,0,4,0"
                    ToolTip="Copy the whole script to the clipboard" Click="CopyButton_Click" />
            <Button x:Name="OpenButton" DockPanel.Dock="Left" Content="Open in new query window" Padding="10,2" Margin="0,0,10,0"
                    ToolTip="Open this script in a new query window on the same connection (not executed)" Click="OpenButton_Click" />
            <ProgressBar x:Name="Spinner" DockPanel.Dock="Left" Width="90" Height="4" Margin="0,0,8,0"
                         IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource ContextTextBrush}" Text="Esc to close" />
        </DockPanel>

        <TextBox x:Name="ScriptTextBox" Grid.Row="1"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource ScriptBackgroundBrush}"
                 Foreground="{StaticResource ScriptTextBrush}"
                 CaretBrush="{StaticResource ScriptTextBrush}"
                 SelectionBrush="{StaticResource ScriptSelectionBrush}" />
    </Grid>
</UserControl>
